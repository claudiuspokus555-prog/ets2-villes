const SVG_W=1600, SVG_H=900;
const LON_MIN=-128, LON_MAX=-88, LAT_MIN=24, LAT_MAX=50;

function proj(lat,lon){
  return {
    x:(lon-LON_MIN)/(LON_MAX-LON_MIN)*SVG_W,
    y:(1-(lat-LAT_MIN)/(LAT_MAX-LAT_MIN))*SVG_H
  };
}
function polyPath(poly){
  return poly.map((p,i)=>{
    const {x,y}=proj(p[1],p[0]);
    return (i===0?'M':'L')+x.toFixed(1)+' '+y.toFixed(1);
  }).join(' ')+'Z';
}

// ============================================================
// STATE
// ============================================================
let scale=1,tx=0,ty=0,isDrag=false,sx,sy,stx,sty;
const dlcVisible={};Object.keys(DLC).forEach(k=>dlcVisible[k]=true);
let showBorders=true,showNames=true;
const mapArea=document.getElementById('mapArea');
const svgEl=document.getElementById('map');
const ttEl=document.getElementById('tooltip');
let gStates,gLabels,gCities;

// ============================================================
// BUILD SVG
// ============================================================
function buildSVG(){
  svgEl.innerHTML='';
  svgEl.setAttribute('viewBox',`0 0 ${SVG_W} ${SVG_H}`);
  svgEl.setAttribute('preserveAspectRatio','xMidYMid meet');
  svgEl.appendChild(mk('rect',{width:SVG_W,height:SVG_H,fill:'#080c10'}));

  // Grid
  const grid=mk('g',{});
  for(let lon=-125;lon<=-88;lon+=5){
    const a=proj(LAT_MIN,lon),b=proj(LAT_MAX,lon);
    grid.appendChild(mk('line',{x1:a.x,y1:a.y,x2:b.x,y2:b.y,stroke:'#0d1a26','stroke-width':0.6}));
  }
  for(let lat=25;lat<=50;lat+=5){
    const a=proj(lat,LON_MIN),b=proj(lat,LON_MAX);
    grid.appendChild(mk('line',{x1:a.x,y1:a.y,x2:b.x,y2:b.y,stroke:'#0d1a26','stroke-width':0.6}));
  }
  svgEl.appendChild(grid);

  // States
  gStates=mk('g',{id:'gStates'});
  svgEl.appendChild(gStates);

  // State labels
  gLabels=mk('g',{id:'gLabels'});
  svgEl.appendChild(gLabels);

  Object.entries(STATES).forEach(([name,sdata])=>{
    sdata.polys.forEach(poly=>{
      const path=mk('path',{
        d:polyPath(poly),
        fill:'rgba(255,255,255,0.04)',
        stroke:'rgba(255,255,255,0.40)',
        'stroke-width':0.9,
        'stroke-linejoin':'round',
        class:'state-shape'
      });
      gStates.appendChild(path);
    });
    const lp=proj(sdata.lLat,sdata.lLon);
    const lbl=mk('text',{
      x:lp.x,y:lp.y,'font-size':13,
      class:'state-label',
      stroke:'rgba(0,0,0,0.8)','stroke-width':3.5,
      'stroke-linejoin':'round','paint-order':'stroke fill'
    });
    lbl.textContent=name;
    gLabels.appendChild(lbl);
  });

  // Cities
  gCities=mk('g',{id:'gCities'});
  svgEl.appendChild(gCities);

  cities.forEach((city,i)=>{
    const p=proj(city.lat,city.lon);
    const col=DLC[city.dlc].color;
    const r=city.cap?5:3;
    const g=mk('g',{class:'city-g','data-idx':i});
    g.style.display=dlcVisible[city.dlc]?'':'none';

    g.appendChild(mk('circle',{cx:p.x,cy:p.y,r,fill:col,class:'cdot',
      stroke:city.cap?'#fff':col,'stroke-width':city.cap?1.5:0,opacity:0.9}));

    const fs=city.cap?11:9;
    const txt=mk('text',{x:p.x+r+2,y:p.y+4,'font-size':fs,fill:col,
      stroke:'#080c10','stroke-width':2.5,'stroke-linejoin':'round',
      class:'clabel','data-dlc':city.dlc,'paint-order':'stroke fill',
      'font-weight':city.cap?'700':'600'});
    txt.textContent=city.name;
    g.appendChild(txt);

    g.addEventListener('mouseenter',e=>showTT(e,city,col));
    g.addEventListener('mouseleave',hideTT);
    g.addEventListener('click',e=>{e.stopPropagation();showTT(e,city,col);});
    gCities.appendChild(g);
  });

  applyTransform();
}

function mk(tag,attrs){
  const el=document.createElementNS('http://www.w3.org/2000/svg',tag);
  for(const[k,v]of Object.entries(attrs))el.setAttribute(k,v);
  return el;
}

// ============================================================
// TRANSFORM
// ============================================================
function applyTransform(){
  const t=`translate(${tx},${ty}) scale(${scale})`;
  gStates.setAttribute('transform',t);
  gLabels.setAttribute('transform',t);
  gCities.setAttribute('transform',t);
  document.getElementById('zlevel').textContent=`Zoom: ${scale.toFixed(1)}×`;
  adaptScale();
}
function adaptScale(){
  svgEl.querySelectorAll('.cdot').forEach(c=>{
    const base=c.getAttribute('stroke')==='#fff'?5:3;
    c.setAttribute('r',base/Math.max(scale,0.5));
  });
  svgEl.querySelectorAll('.clabel').forEach(t=>{
    const base=t.closest('.city-g').querySelector('.cdot').getAttribute('stroke')==='#fff'?11:9;
    t.setAttribute('font-size',Math.max(5,base/Math.max(scale,0.5)));
    t.setAttribute('stroke-width',2.5/Math.max(scale,0.5));
    const r=parseFloat(t.closest('.city-g').querySelector('.cdot').getAttribute('r'));
    t.setAttribute('x',parseFloat(t.closest('.city-g').querySelector('.cdot').getAttribute('cx'))+r+2);
  });
  svgEl.querySelectorAll('.state-shape').forEach(p=>{
    p.setAttribute('stroke-width',0.9/Math.max(scale,0.5));
  });
  svgEl.querySelectorAll('.state-label').forEach(t=>{
    t.setAttribute('font-size',Math.max(7,13/Math.max(scale,0.5)));
    t.setAttribute('stroke-width',3.5/Math.max(scale,0.5));
  });
}

// ============================================================
// PAN / ZOOM
// ============================================================
mapArea.addEventListener('wheel',e=>{
  e.preventDefault();
  const rect=mapArea.getBoundingClientRect();
  const scX=SVG_W/rect.width,scY=SVG_H/rect.height;
  const mx=(e.clientX-rect.left)*scX,my=(e.clientY-rect.top)*scY;
  const d=e.deltaY<0?1.15:0.87;
  const ns=Math.min(14,Math.max(0.4,scale*d));
  tx=mx-(mx-tx)*(ns/scale);ty=my-(my-ty)*(ns/scale);scale=ns;
  applyTransform();
},{passive:false});
mapArea.addEventListener('mousedown',e=>{
  isDrag=true;sx=e.clientX;sy=e.clientY;stx=tx;sty=ty;
  mapArea.classList.add('drag');
});
document.addEventListener('mousemove',e=>{
  if(!isDrag)return;
  const rect=mapArea.getBoundingClientRect();
  tx=stx+(e.clientX-sx)*(SVG_W/rect.width);
  ty=sty+(e.clientY-sy)*(SVG_H/rect.height);
  applyTransform();
});
document.addEventListener('mouseup',()=>{isDrag=false;mapArea.classList.remove('drag');});
document.getElementById('zIn').onclick=()=>{scale=Math.min(14,scale*1.3);applyTransform();};
document.getElementById('zOut').onclick=()=>{scale=Math.max(0.4,scale/1.3);applyTransform();};
document.getElementById('zReset').onclick=()=>{scale=1;tx=0;ty=0;applyTransform();};

// ============================================================
// TOGGLES
// ============================================================
document.getElementById('btnBorders').addEventListener('click',function(){
  showBorders=!showBorders;this.classList.toggle('active',showBorders);
  gStates.style.display=showBorders?'':'none';
});
document.getElementById('btnStateNames').addEventListener('click',function(){
  showNames=!showNames;this.classList.toggle('active',showNames);
  gLabels.style.display=showNames?'':'none';
});

// ============================================================
// TOOLTIP
// ============================================================
function showTT(e,city,col){
  ttEl.innerHTML=`
    <div class="tt-name" style="color:${col}">${city.name}</div>
    <div class="tt-state">📍 ${city.state}</div>
    <div class="tt-dlc" style="color:${col}">${DLC[city.dlc].label}</div>
    ${city.cap?'<div style="color:#ffcc44;font-size:.7rem">★ Capitale d\'État</div>':''}
  `;
  ttEl.style.display='block';moveTT(e);
}
function hideTT(){ttEl.style.display='none';}
function moveTT(e){
  let x=e.clientX+14,y=e.clientY-36;
  if(x+240>window.innerWidth)x=e.clientX-255;
  if(y<0)y=e.clientY+10;
  ttEl.style.left=x+'px';ttEl.style.top=y+'px';
}
mapArea.addEventListener('mousemove',e=>{if(ttEl.style.display==='block')moveTT(e);});

// ============================================================
// LEGEND
// ============================================================
const legendWrap=document.getElementById('legend');
Object.entries(DLC).forEach(([key,dlc])=>{
  const el=document.createElement('div');el.className='leg';el.dataset.key=key;
  el.innerHTML=`<div class="leg-dot" style="background:${dlc.color}"></div><span>${dlc.label}</span>`;
  el.addEventListener('click',()=>{
    dlcVisible[key]=!dlcVisible[key];
    el.classList.toggle('off',!dlcVisible[key]);
    svgEl.querySelectorAll('.city-g').forEach(g=>{
      if(cities[+g.dataset.idx].dlc===key)g.style.display=dlcVisible[key]?'':'none';
    });
  });
  legendWrap.appendChild(el);
});

// ============================================================
// SEARCH
// ============================================================
const searchBox=document.getElementById('searchBox');
const searchRes=document.getElementById('searchResults');
function norm(s){return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');}
searchBox.addEventListener('input',()=>{
  const q=norm(searchBox.value.trim());
  if(!q){searchRes.style.display='none';return;}
  const matches=cities.filter(c=>norm(c.name).includes(q)||norm(c.state).includes(q)).slice(0,25);
  if(!matches.length){searchRes.style.display='none';return;}
  searchRes.innerHTML='';
  matches.forEach(c=>{
    const d=document.createElement('div');d.className='sr-item';
    const col=DLC[c.dlc].color;
    d.innerHTML=`<div class="sr-dot" style="background:${col}"></div>
      <div class="sr-main">
        <span class="sr-name">${c.name}${c.cap?' ★':''}</span>
        <span class="sr-meta">${c.state} · ${DLC[c.dlc].label}</span>
      </div>`;
    d.addEventListener('click',()=>{flyTo(c);searchRes.style.display='none';searchBox.value='';});
    searchRes.appendChild(d);
  });
  searchRes.style.display='block';
});
document.addEventListener('click',e=>{if(!e.target.closest('.search-wrap'))searchRes.style.display='none';});

function flyTo(city){
  const p=proj(city.lat,city.lon);
  const rect=mapArea.getBoundingClientRect();
  scale=5;
  tx=(rect.width/2)*(SVG_W/rect.width)-p.x*scale;
  ty=(rect.height/2)*(SVG_H/rect.height)-p.y*scale;
  applyTransform();
}

document.getElementById('counter').textContent=`${cities.length} villes`;
buildSVG();
</script>
</body>
</html>
