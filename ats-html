<title>ATS — American Truck Simulator Map</title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root { --bg:#080c10; --panel:#0d1520; --border:#162030; --text:#d0e0f0; --dim:#486070; --accent:#e05020; }
body { background:var(--bg); color:var(--text); font-family:'Rajdhani',sans-serif; height:100vh; display:flex; flex-direction:column; overflow:hidden; }
header { background:var(--panel); border-bottom:2px solid #1a3040; padding:7px 13px; display:flex; gap:9px; align-items:center; flex-wrap:wrap; flex-shrink:0; z-index:20; }
.logo { font-size:1.3rem; font-weight:700; letter-spacing:3px; color:var(--accent); text-shadow:0 0 15px rgba(224,80,32,.5); white-space:nowrap; }
.logo span { color:var(--text); }
.search-wrap { position:relative; }
#searchBox { background:var(--bg); border:1px solid var(--border); color:var(--text); padding:5px 10px; font-family:'Share Tech Mono',monospace; font-size:.8rem; outline:none; width:210px; }
#searchBox:focus { border-color:var(--accent); }
#searchResults { position:absolute; top:30px; left:0; background:var(--panel); border:1px solid var(--accent); max-height:280px; overflow-y:auto; z-index:200; display:none; font-family:'Share Tech Mono',monospace; font-size:.78rem; min-width:280px; }
.sr-item { padding:5px 10px; cursor:pointer; border-bottom:1px solid var(--border); display:flex; gap:8px; align-items:flex-start; }
.sr-item:hover { background:#162030; }
.sr-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; margin-top:4px; }
.sr-main { display:flex; flex-direction:column; }
.sr-name { color:var(--text); font-size:.85rem; font-family:'Rajdhani',sans-serif; font-weight:600; }
.sr-meta { color:var(--dim); font-size:.68rem; }
.legend-wrap { display:flex; flex-wrap:wrap; gap:4px 8px; align-items:center; font-family:'Share Tech Mono',monospace; font-size:.68rem; }
.leg { display:flex; align-items:center; gap:4px; cursor:pointer; padding:2px 4px; border:1px solid transparent; user-select:none; transition:border-color .2s; }
.leg:hover { border-color:var(--border); }
.leg.off { opacity:.3; }
.leg-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
.options { display:flex; gap:6px; align-items:center; }
.opt-btn { background:var(--panel); border:1px solid var(--border); color:var(--text); padding:3px 8px; font-family:'Share Tech Mono',monospace; font-size:.68rem; cursor:pointer; transition:border-color .2s,color .2s; white-space:nowrap; }
.opt-btn:hover,.opt-btn.active { border-color:var(--accent); color:var(--accent); }
.zoom-wrap { display:flex; gap:3px; margin-left:auto; }
.zb { background:var(--panel); border:1px solid var(--border); color:var(--text); width:26px; height:26px; cursor:pointer; font-size:1rem; display:flex; align-items:center; justify-content:center; transition:border-color .2s,color .2s; }
.zb:hover { border-color:var(--accent); color:var(--accent); }
.zb.wide { width:42px; font-size:.62rem; font-family:'Share Tech Mono',monospace; }
#counter { font-family:'Share Tech Mono',monospace; font-size:.7rem; color:var(--dim); white-space:nowrap; }
.map-area { flex:1; overflow:hidden; cursor:grab; position:relative; }
.map-area.drag { cursor:grabbing; }
svg#map { width:100%; height:100%; display:block; }
.state-shape { transition:fill .2s; }
.state-shape:hover { fill-opacity:.2 !important; }
.city-g { cursor:pointer; }
.city-g:hover .cdot { filter:brightness(2); }
.cdot { }
.clabel { font-family:'Rajdhani',sans-serif; font-weight:600; pointer-events:none; paint-order:stroke fill; }
.state-label { pointer-events:none; font-family:'Rajdhani',sans-serif; font-weight:700; fill:rgba(255,255,255,0.5); paint-order:stroke fill; text-anchor:middle; dominant-baseline:middle; letter-spacing:1px; }
.tooltip { position:absolute; background:var(--panel); border:1px solid var(--accent); padding:7px 12px; font-family:'Share Tech Mono',monospace; font-size:.76rem; pointer-events:none; display:none; z-index:100; max-width:240px; box-shadow:0 0 20px rgba(224,80,32,.2); line-height:1.7; }
.tt-name { font-family:'Rajdhani',sans-serif; font-size:1.1rem; font-weight:700; }
.tt-state { font-size:.8rem; color:#8ab0c8; }
.tt-dlc { font-size:.68rem; }
.infobar { padding:4px 13px; background:var(--panel); border-top:1px solid var(--border); font-family:'Share Tech Mono',monospace; font-size:.66rem; color:var(--dim); display:flex; gap:14px; flex-shrink:0; }
</style>
</head>
